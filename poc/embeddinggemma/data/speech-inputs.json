        "transcript": [
          {
            "startSec": 0,
            "endSec": 4.54,
            "text": "U.S. Customs and Border Protection's count down to kickoff, 48 hours until game time."
          },
          {
            "startSec": 5.06,
            "endSec": 11.23,
            "text": "And U.S. Customs and Border Protection's Air and Marine Operations is high above U.S. Bank Stadium today, taking a look at the no-fly zone."
          },
          {
            "startSec": 11.23,
            "endSec": 15.08,
            "text": "Most Americans don't realize the no-fly zone they put into effect over the U.S. Bank Stadium during game day."
          },
          {
            "startSec": 18.23,
            "endSec": 25.42,
            "text": "The no-fly zone this year will take effect at 3:30 in the afternoon and last until midnight in a 32-mile radius around the stadium."
          },
