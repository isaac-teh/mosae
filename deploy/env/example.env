# Copy to dev.env or prod.env and replace every example value. No secrets here.
PROJECT_ID=example-mosae-dev
REGION=asia-southeast1
BUCKET=example-mosae-dev.firebasestorage.app
ARTIFACT_REPO=mosae
API_SERVICE=mosae-api
RENDER_SERVICE=mosae-render
TASKS_QUEUE=mosae-tasks
EVENTARC_TRIGGER=mosae-storage-finalize
WEB_ORIGIN=https://example-mosae-dev.web.app
ALLOWED_ORIGINS=https://example-mosae-dev.web.app
EXPO_PUBLIC_FIREBASE_API_KEY=example-public-firebase-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=example-mosae-dev.firebaseapp.com
EXPO_PUBLIC_FIREBASE_APP_ID=example-firebase-app-id
