{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run --exclude \"src/store/**\" --exclude \"src/**/*.emulator.test.ts\"",
    "vitest:store": "vitest run src/store --no-file-parallelism",
    "test:emulator": "cd ../.. && firebase emulators:exec --only firestore,storage --project demo-mosae \"npm run vitest:store -w services/api -- src/directing/directing.emulator.test.ts\"",
    "replay:finalize": "tsx --env-file-if-exists=.env scripts/replayFinalize.ts"
  },
  "dependencies": {
    "@google-cloud/tasks": "^5.5.0",
    "@google/genai": "^2.23.0",
    "@mosae/contracts": "*",
    "exiftool-vendored": "^38.0.1",
    "express": "^4.19.0",
    "firebase-admin": "^12.3.0",
    "google-auth-library": "^9.15.1",
    "sharp": "^0.35.4",
    "tz-lookup": "^6.1.25",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/express": "^4.17.0",
    "@types/node": "^20.14.0",
    "@types/supertest": "^7.2.1",
    "@types/tz-lookup": "^6.1.2",
    "supertest": "^7.2.2",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
