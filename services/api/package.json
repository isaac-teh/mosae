{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run --exclude \"src/store/**\"",
    "vitest:store": "vitest run src/store --no-file-parallelism",
    "test:emulator": "cd ../.. && firebase emulators:exec --only firestore --project demo-mosae \"npm run vitest:store -w services/api\""
  },
  "dependencies": {
    "@google-cloud/tasks": "^5.5.0",
    "@google/genai": "^0.12.0",
    "express": "^4.19.0",
    "firebase-admin": "^12.3.0",
    "google-auth-library": "^9.15.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.14.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
