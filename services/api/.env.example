FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Must exactly match the Eventarc bucket and the Expo web app's EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET. New projects use <project>.firebasestorage.app.
FIREBASE_STORAGE_BUCKET=
GEMINI_API_KEY=
PORT=8080
NODE_ENV=development
# Cloud Run run.app URL of this service; Eventarc and Cloud Tasks OIDC audiences are checked against it.
SERVICE_URL=http://localhost:8080
# Comma-separated service accounts allowed to call /events, /tasks, and /internal.
INVOKER_SERVICE_ACCOUNTS=
GCP_PROJECT_ID=
TASKS_LOCATION=asia-southeast1
TASKS_QUEUE=mosae-ingest
TASKS_INVOKER_SERVICE_ACCOUNT=
# Local emulators
# FIREBASE_PROJECT_ID=demo-mosae
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# FIREBASE_STORAGE_BUCKET=demo-mosae.appspot.com
# ALLOWED_ORIGINS=http://localhost:8081
# SERVICE_URL and PORT must match EXPO_PUBLIC_API_BASE_URL in apps/client/.env.local.
# Local uploads need `npm run replay:finalize` because the Storage emulator emits no finalize events.
